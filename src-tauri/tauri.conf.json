{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QWE Healing Clicker",
  "version": "0.4.0",
  "identifier": "com.qwe.healingclicker",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QWE Healing Clicker",
        "width": 480,
        "height": 260,
        "minWidth": 480,
        "minHeight": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Q, W, E를 누르며 잠깐 쉬어가는 힐링 클리커",
    "longDescription": "파스텔 키 스위치의 움직임과 부드러운 소리를 즐기는 작은 데스크톱 힐링 오브제입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
