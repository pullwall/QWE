{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QWE Healing Clicker",
  "version": "0.5.0",
  "identifier": "com.qwe.healingclicker",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "QWE Healing Clicker",
        "width": 480,
        "height": 260,
        "minWidth": 480,
        "minHeight": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A tiny pastel desktop clicker for Q, W, and E.",
    "longDescription": "A quiet desktop object with pastel key switches, gentle motion, and soft typing sounds.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
